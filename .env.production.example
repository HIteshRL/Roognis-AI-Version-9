# Copy to .env.production on the Oracle VM. Never commit the real file.

# Public URL and Let's Encrypt registration
APP_DOMAIN=learn.example.com
ACME_EMAIL=admin@example.com

# Generate each value independently with: openssl rand -hex 32
# Hex keeps DATABASE_URL safe without additional URL encoding.
DB_PASSWORD=replace-with-random-hex
JWT_SECRET=replace-with-random-hex
INTERNAL_SERVICE_TOKEN=replace-with-random-hex

# One-time first deployment bootstrap. Generate the UUID with: uuidgen
SEED_DEMO_USERS=false
ALLOW_SELF_REGISTRATION=false
COOKIE_SECURE=true
BOOTSTRAP_ENABLED=true
BOOTSTRAP_SCHOOL_ID=replace-with-uuid
BOOTSTRAP_SCHOOL_NAME="Roognis Pilot School"
BOOTSTRAP_TEACHER_NAME="Pilot Teacher"
BOOTSTRAP_TEACHER_EMAIL=teacher@example.com
BOOTSTRAP_TEACHER_PASSWORD=replace-with-a-long-random-password

# Hosted AI providers; do not enable the local-ai profile on Oracle Free Tier.
LLM_PROVIDER=gemini
IMAGE_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

OPENROUTER_API_KEY=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_QUIZ_MODEL=openai/gpt-5-mini
OPENROUTER_QUIZ_REASONING_EFFORT=low
OPENROUTER_QUIZ_TIMEOUT_MS=60000
OPENROUTER_QUIZ_MAX_COMPLETION_TOKENS=4200
OPENROUTER_APP_NAME=Roognis
QUIZ_QUESTION_COUNT=10

VIDEO_PROVIDER=youtube
YOUTUBE_API_KEY=
VIDEO_SEARCH_MAX_RESULTS=5
VIDEO_TRUSTED_CHANNELS=

# Lightweight deterministic retrieval fits the free ARM VM.
RAG_TEST_MODE=true
RAG_COLLECTION_PREFIX=school
RAG_MAX_UPLOAD_MB=50

NEWS_REFRESH_ENABLED=true
NEWS_REFRESH_INTERVAL_MS=10800000

# First boot only: the bootstrap teacher uploads bundled textbooks.
# After successful seeding, set both flags to false and remove the two passwords.
AUTO_SEED_TEXTBOOKS=true
SEED_TEACHER_EMAIL=teacher@example.com
SEED_TEACHER_PASSWORD=replace-with-the-bootstrap-teacher-password

{
  "name": "roognis-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Roognis web SPA — teacher & student LMS UI (Google-Classroom parity) over the microservice gateway.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
